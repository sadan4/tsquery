{
  "name": "@sadan4/tsquery",
  "version": "7.1.1",
  "description": "Query TypeScript ASTs with the esquery API!",
  "exports": {
    ".": {
      "import": "./dist/esm/src/index.js",
      "require": "./dist/src/index.js"
    }
  },
  "author": "sadan",
  "repository": {
    "type": "git",
    "url": "https://github.com/sadan4/tsquery"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm clean && pnpm compile",
    "clean": "rimraf dist",
    "compile": "pnpm compile:cjs && pnpm compile:esm",
    "compile:cjs": "tsc",
    "compile:esm": "tsc -p ./tsconfig.esm.json && tsc-alias -f -p ./tsconfig.esm.json",
    "lint": "pnpm lint:src && pnpm lint:test",
    "lint:src": "eslint src/**/*.ts",
    "lint:test": "eslint test/**/*.ts",
    "lint:fix": "npm run lint:src:fix && npm run lint:test",
    "lint:src:fix": "eslint src/**/*.ts --fix",
    "lint:test:fix": "eslint test/**/*.ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@types/esquery": "^1.5.4",
    "esquery": "^1.6.0"
  },
  "peerDependencies": {
    "typescript": "^3 || ^4 || ^5"
  },
  "files": [
    "dist/src",
    "dist/esm/src"
  ],
  "devDependencies": {
    "@types/node": "^20.4.0",
    "@typescript-eslint/eslint-plugin": "^5.61.0",
    "@typescript-eslint/parser": "^5.61.0",
    "@vitest/coverage-v8": "4.0.6",
    "@vitest/ui": "4.0.6",
    "eslint": "^8.44.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.26.0",
    "prettier": "^3.0.0",
    "rimraf": "^3.0.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.1.6",
    "vitest": "^4.0.6"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "<rootDir>/src/**"
    ],
    "coverageDirectory": "<rootDir>/reports/coverage",
    "transform": {
      "\\.(ts)$": "ts-jest"
    },
    "testRegex": "/test/.*\\.spec\\.ts$"
  }
}
